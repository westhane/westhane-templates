\rules only macrocallinline

/* Wrapper: contains the float so it can't spill into the next tiddler */
.portrait-view {
	display: flow-root;
}

.portrait {
	float: right;
	width: 20%;
	height: auto;
	margin: 0 0 0.5em 1em;
	border-radius: 4px;
}

/* Tab divider line: own formatting context, so it stops at the
   portrait's edge instead of running underneath it */
.portrait-view .tc-tab-divider {
	display: flow-root;
}
